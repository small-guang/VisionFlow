# Copy this file to .env and fill values for the environment you run against.
# Optional algorithm profile override. Relative paths resolve from /app.
# ALGORITHM_CONFIG_PATH=config/algorithm.toml
# Comma-separated device SNs whose normal keyframe person crops need Pose-based upright rotation.
# panoKeyframeUrl processing is enabled automatically and does not need to be listed here.
PERSON_UPRIGHT_DEVICE_SNS=

# 同帧整图人脸结果默认复用到 feature 阶段；on=启用，off=紧急关闭并使用完整本地流程
PERSON_FACE_REUSE_MODE=on

# 独立阶段队列统计日志，每行 JSON；不包含图片、向量或身份内容。
PIPELINE_STATS_ENABLED=true
PIPELINE_STATS_PATH=logs/pipeline_stats.jsonl
PIPELINE_STATS_INTERVAL_SECONDS=5
# 输出 queued+inflight 达高水位暂停领取新消息，降到低水位恢复；非内存硬上限。
OUTPUT_BACKLOG_HIGH_WATERMARK=2000
OUTPUT_BACKLOG_LOW_WATERMARK=1000

# PostgreSQL
PGSQL_HOST=
PGSQL_PORT=
PGSQL_DB=
PGSQL_USER=
PGSQL_PSWD=

# Vector Database
MILVUS_URI=
MILVUS_TOKEN=
# 留空使用现有集合；隔离测试可设 alog_test_，直接前缀到四个集合名，不迁移旧数据。
MILVUS_COLLECTION_PREFIX=

# Kafka
KAFKA_BROKER_ADDR=
KAFKA_BROKER_PORT=
KAFKA_GROUP_ID=ptz_detection_group
# 逗号分隔的输入 Topic；隔离回放时连同独立消费组、输出 Topic 一起配置。
KAFKA_INPUT_TOPICS=PanoramicPersonDetSync,PtzPersonDetSync,PtzFaceDetSync
KAFKA_FACE_DETECTION_RECORD_TOPIC=app-camtells-face-detection-record-topic
KAFKA_FACE_RECOGNITION_RECORD_TOPIC=app-camtells-face-recognition-record-topic
KAFKA_PERSON_DETECTION_RECORD_TOPIC=app-camtells-person-detection-record-topic
KAFKA_PERSON_RECOGNITION_RECORD_TOPIC=app-camtells-person-recognition-record-topic
KAFKA_VECTOR_RECORD_TOPIC=app-camtells-vector-record-topic
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Required only when KAFKA_SECURITY_PROTOCOL is SASL_PLAINTEXT or SASL_SSL.
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=PLAIN

# Triton inference. VisionFlow and Triton may run on different hosts.
# Set a network-reachable Triton gRPC endpoint (normally host:8001).
TRITON_SERVER_URL=
ALOG_WORKER_COUNT=32
# 默认 owner + 4 个视觉进程；0 可用于受限环境，资源总额按进程分账。
VISUAL_WORKER_PROCESSES=4
# IPC 为每个 peer 的每类额度，增加视觉进程数会增加整组 IPC 额度。
# 每个私有IPC连接的额度；请求、帧准入请求与回复分别预留，不能合称总RSS上限。
MULTIPROCESS_IPC_MAX_REQUESTS=128
MULTIPROCESS_IPC_MAX_BYTES=67108864
MULTIPROCESS_IPC_MAX_PAYLOAD_BYTES=4194304
MULTIPROCESS_START_TIMEOUT_SECONDS=90
MULTIPROCESS_STOP_TIMEOUT_SECONDS=60
# 独立消息所有权上限；0 沿用 worker 数，覆盖一条消息的主图与全景图处理。
# 按消息数量限制，不是图片/目标数量或字节内存硬上限。
ALOG_MAX_INFLIGHT_MESSAGES=100
# 下载前的图片接纳；0 沿用有效消息容量，主图和全景图各自占一个名额。
ALOG_MAX_INFLIGHT_FRAMES=100
# 固定估算字节预算，0 关闭；非 RSS 硬限。正数至少容纳一份预留。
FRAME_MEMORY_BUDGET_BYTES=0
FRAME_RESERVATION_BYTES=67108864
# 四个有界资源域；多进程时image/storage分给视觉进程，search/write只在owner创建。
IMAGE_CPU_WORKERS=4
# 显式存储线程容量，必须为正；不继承其他资源池。
STORAGE_IO_WORKERS=64
# 同一存储总容量内给下载保底，上传上限=有效总容量-保底；0 保持原共享准入。
# 多进程启用时，保底及剩余上传容量均须至少等于 VISUAL_WORKER_PROCESSES。
STORAGE_DOWNLOAD_RESERVED_WORKERS=4
MILVUS_SEARCH_WORKERS=16
MILVUS_WRITE_WORKERS=4
# Face 查询统一由有界调度器合批；1 仅表示单条批大小，仍经过相同调度路径。
MILVUS_QUERY_BATCH_SIZE=4
MILVUS_QUERY_WAIT_MS=1
# 已接纳排队 + 真实在途向量上限；满时等待，不复制身份状态。
MILVUS_QUERY_CAPACITY=128
# 同机大图系统共享内存，默认关闭；启用需 Triton --allow-client-shm=true。
# VisionFlow 与 Triton 均使用 host IPC 时，将 ALOG_IPC_MODE 改为 host 并重建容器。
TRITON_SYSTEM_SHM_SLOTS=0
TRITON_SYSTEM_SHM_SLOT_BYTES=33554432
ALOG_IPC_MODE=private
# 每帧同时准备人脸的上限 N；未提交总容量为 N + FACE_PREPARE_LOOKAHEAD。
FACE_FRAME_CONCURRENCY=30
# Face preparation/inference slots shared by all workers, released before identity waits.
FACE_GLOBAL_CONCURRENCY=100
# 额外前瞻容量 M；0 保持原 N 项窗口；同帧串行需同时设置 N=1、M=0。
FACE_PREPARE_LOOKAHEAD=2
# 控制 Face 初次预取及最多一次锁外刷新；最终仍持锁复核版本、最新 pending 和质量门槛。
FACE_SEARCH_PREFETCH_ENABLED=true
# 每帧同时准备人物的上限 N；未提交总容量为 N + PERSON_PREPARE_LOOKAHEAD。
PERSON_FRAME_CONCURRENCY=30
# 人物视觉准备与 embedding 推理名额，不包含等待 Face 解析的时间。
PERSON_GLOBAL_CONCURRENCY=100
# 人物内部 Face 解析独立容量；0 沿用 PERSON_GLOBAL_CONCURRENCY。
PERSON_FACE_CONCURRENCY=0
PERSON_PREPARE_LOOKAHEAD=2
# 默认真实组批；远程模型须支持 B4，启动时会验证实际 max_batch_size。
TRITON_BATCH_TARGET_DEFAULT=4
TRITON_BATCH_WAIT_MS_DEFAULT=2
# JSON maps use stable VisionFlow business keys. Empty maps inherit the defaults above.
# Any per-model target above 1 also requires a positive wait in TRITON_BATCH_WAIT_MS.
# Lower a target and restart VisionFlow before lowering Triton's remote max_batch_size.
TRITON_BATCH_TARGETS={}
TRITON_BATCH_WAIT_MS={}
TRITON_QUEUE_TIMEOUT_SECONDS=60
TRITON_CLIENT_ACQUIRE_TIMEOUT_SECONDS=5
TRITON_INFER_TIMEOUT_SECONDS=30
TRITON_CONFIG_TIMEOUT_SECONDS=5
TRITON_CLIENT_POOL_SIZE=100
TRITON_EXECUTOR_CONCURRENCY=80
TRITON_EXECUTOR_QUEUE_CAPACITY=256
TRITON_TRANSIENT_RETRIES=0

# Object storage: oss (default) or minio. Restart VisionFlow after changes.
STORAGE_BACKEND=oss
# 仅为新裁图添加 object key 前缀；原图仍按输入 key 读取。留空保持原路径。
STORAGE_OUTPUT_PREFIX=
# Required only for STORAGE_BACKEND=oss.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=

# To switch, set STORAGE_BACKEND=minio and fill these values.
# API host:port reachable from VisionFlow; no http(s) scheme, console port or disk path.
# Example: MINIO_ENDPOINT=minio-host:9000, MINIO_BUCKET_NAME=visionflow-images
# Prepare a separate image bucket; do not use Milvus internal a-bucket/files.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_SECURE=false
